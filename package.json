{
  "name": "dsh-pwa",
  "version": "0.4.1",
  "description": "PWA & Mobile for DeepSeek Harness Web: installable iOS/iPadOS and browser PWA icons plus a switchable phone layout",
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "assets/*.png",
    "LICENSE",
    "LICENSE.DeepSeek",
    "NOTICE.md",
    "client.js",
    "updates.js",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "pack:plugin": "npm pack --ignore-scripts",
    "test:browser": "node scripts/browser-check.mjs",
    "check:dsh-peer": "node scripts/check-dsh-peer.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pwa",
    "mobile",
    "ios",
    "ipad",
    "tailscale"
  ],
  "license": "MIT",
  "dependencies": {
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-alpha.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  }
}
